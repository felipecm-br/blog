---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: 'awt (Agent Worktree Manager)',
    description: 'Autonomous Git worktree orchestrator and multi-agent workflow manager for hermetic development sandboxes.',
    tags: ['bash', 'git', 'cli', 'automation'],
    link: 'https://github.com/felipecm-br/awt',
    badge: 'Active',
  },
  {
    title: 'waymaker',
    description: 'High-speed fuzzy search and modal TUI picker for terminal and window manager workflows.',
    tags: ['rust', 'tui', 'wayland', 'ergonomics'],
    link: 'https://github.com/felipecm-br/waymaker',
    badge: 'Open Source',
  },
  {
    title: 'waymux',
    description: 'The Terminal AI Multiplexer bringing modal navigation and dynamic window tiling to developers.',
    tags: ['tmux', 'workflow', 'ai'],
    link: 'https://github.com/felipecm-br/waymux',
    badge: 'Tool',
  },
  {
    title: 'Developer Blog',
    description: 'State-of-the-art Astro 5 static blog featuring personalized SEO and 22 switchable Omarchy system themes.',
    tags: ['astro', 'tailwind', 'seo', 'theming'],
    link: 'https://github.com/felipecm-br/blog',
    badge: 'Live',
  },
];
---

<BaseLayout
  title="Projects // Work & Open Source"
  description="Selected open source tooling, terminal utilities, and web platforms built by Felipe Miranda."
>
  <div class="mb-10 pb-6 border-b border-theme-border">
    <div class="flex items-center gap-2 mb-2 font-mono text-xs text-accent">
      <span>~</span>
      <span>/</span>
      <span>projects</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-fg-primary mb-2">
      Featured Projects
    </h1>
    <p class="text-sm text-fg-secondary">
      Tools, terminal multiplexers, and open-source utilities built for speed and low-friction ergonomics.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {projects.map((proj) => (
      <div class="p-6 rounded-xl border border-theme-border bg-bg-secondary card-hover flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <h3 class="font-bold text-lg text-fg-primary">{proj.title}</h3>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-bg-tertiary text-accent border border-theme-border">
              {proj.badge}
            </span>
          </div>
          <p class="text-xs text-fg-secondary leading-relaxed mb-4">
            {proj.description}
          </p>
        </div>

        <div>
          <div class="flex flex-wrap gap-1 mb-4">
            {proj.tags.map((t) => (
              <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-bg-primary text-fg-muted border border-theme-border">
                {t}
              </span>
            ))}
          </div>

          <a
            href={proj.link}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-mono text-accent hover:underline font-medium"
          >
            <span>View on GitHub</span>
            <span>→</span>
          </a>
        </div>
      </div>
    ))}
  </div>
</BaseLayout>
