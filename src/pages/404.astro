---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 Not Found"
  description="The requested page could not be found."
>
  <div class="py-16 sm:py-24 text-center max-w-lg mx-auto space-y-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-theme-red/10 border border-theme-red/30 text-theme-red">
      <span>●</span>
      <span>ERROR: STATUS_404_PAGE_NOT_FOUND</span>
    </div>

    <h1 class="text-6xl sm:text-7xl font-extrabold font-mono text-accent">
      404
    </h1>

    <div class="p-4 rounded-xl border border-theme-border bg-bg-secondary font-mono text-xs text-left text-fg-secondary space-y-1">
      <p><span class="text-accent">$</span> curl -I {Astro.url.pathname}</p>
      <p class="text-theme-red">HTTP/2 404 Not Found</p>
      <p class="text-fg-muted">zsh: path not found in content directory tree.</p>
    </div>

    <p class="text-sm text-fg-secondary">
      The file, route or resource you are trying to reach does not exist or has been moved.
    </p>

    <div class="pt-2">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-accent text-bg-primary font-mono text-xs font-bold hover:bg-accent-hover transition-colors"
      >
        <span>← cd $HOME</span>
      </a>
    </div>
  </div>
</BaseLayout>
