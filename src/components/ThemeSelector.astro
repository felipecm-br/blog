---
import { THEMES } from '../data/themes';
---

<div class="relative inline-block text-left" id="theme-selector-container">
  <!-- Trigger Button -->
  <button
    id="theme-menu-button"
    type="button"
    class="flex items-center gap-2 px-3 py-1.5 text-xs font-mono rounded-md border border-theme-border bg-bg-secondary hover:bg-bg-tertiary hover:border-accent text-fg-primary transition-all duration-150 focus:outline-none focus:ring-1 focus:ring-accent"
    aria-expanded="false"
    aria-haspopup="true"
    title="Change theme (Press 'T' anywhere)"
  >
    <span class="w-2.5 h-2.5 rounded-full bg-accent inline-block shadow-sm" id="active-theme-dot"></span>
    <span id="active-theme-name" class="font-medium capitalize">Theme</span>
    <kbd class="hidden sm:inline-block px-1 py-0.5 text-[10px] text-fg-muted bg-bg-primary rounded border border-theme-border">T</kbd>
    <svg class="w-3.5 h-3.5 text-fg-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <!-- Dropdown Modal / Palette Menu -->
  <div
    id="theme-dropdown"
    class="hidden absolute right-0 mt-2 w-80 max-h-[85vh] overflow-y-auto rounded-xl border border-theme-border bg-bg-primary shadow-2xl p-3 z-50 transition-all duration-150"
    role="menu"
  >
    <!-- Header -->
    <div class="flex items-center justify-between pb-2 mb-2 border-b border-theme-border">
      <div>
        <h4 class="text-xs font-semibold text-fg-primary uppercase tracking-wider">Omarchy Themes</h4>
        <p class="text-[11px] text-fg-muted">22 switchable system palettes</p>
      </div>
      <button id="close-theme-menu" class="text-fg-muted hover:text-fg-primary text-xs p-1">
        ✕
      </button>
    </div>

    <!-- Mode Filter Tabs -->
    <div class="flex gap-1 mb-3 p-1 rounded-lg bg-bg-secondary border border-theme-border text-xs">
      <button type="button" data-filter="all" class="theme-filter-btn flex-1 py-1 rounded text-center font-medium transition-colors bg-bg-tertiary text-accent">
        All (22)
      </button>
      <button type="button" data-filter="dark" class="theme-filter-btn flex-1 py-1 rounded text-center font-medium text-fg-muted hover:text-fg-primary transition-colors">
        🌙 Dark
      </button>
      <button type="button" data-filter="light" class="theme-filter-btn flex-1 py-1 rounded text-center font-medium text-fg-muted hover:text-fg-primary transition-colors">
        ☀️ Light
      </button>
    </div>

    <!-- Theme List Grid -->
    <div class="space-y-1" id="theme-options-list">
      {THEMES.map((t) => (
        <button
          type="button"
          data-theme-id={t.id}
          data-theme-mode={t.mode}
          class="theme-option-btn w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-left text-xs transition-all duration-150 hover:bg-bg-tertiary group border border-transparent hover:border-theme-border"
          role="menuitem"
        >
          <div class="flex items-center gap-2.5">
            <!-- Palette Color Swatch Preview -->
            <div class="flex items-center -space-x-1">
              <span class="w-3.5 h-3.5 rounded-full border border-black/20" style={`background-color: ${t.palette.bg};`}></span>
              <span class="w-3.5 h-3.5 rounded-full border border-black/20" style={`background-color: ${t.palette.card};`}></span>
              <span class="w-3.5 h-3.5 rounded-full border border-black/20" style={`background-color: ${t.palette.accent};`}></span>
            </div>
            <div>
              <span class="font-medium text-fg-primary block group-hover:text-accent transition-colors">{t.label}</span>
              <span class="text-[10px] text-fg-muted capitalize">{t.mode}</span>
            </div>
          </div>

          <span class="theme-check-icon opacity-0 text-accent font-bold text-sm">✓</span>
        </button>
      ))}
    </div>
  </div>
</div>

<script>
  function initThemeSelector() {
    const btn = document.getElementById('theme-menu-button');
    const menu = document.getElementById('theme-dropdown');
    const closeBtn = document.getElementById('close-theme-menu');
    const activeLabel = document.getElementById('active-theme-name');
    const activeDot = document.getElementById('active-theme-dot');
    const options = document.querySelectorAll('.theme-option-btn');
    const filterBtns = document.querySelectorAll('.theme-filter-btn');

    if (!btn || !menu) return;

    function getActiveTheme() {
      return document.documentElement.getAttribute('data-theme') || 'catppuccin';
    }

    function updateActiveUI() {
      const current = getActiveTheme();
      if (activeLabel) activeLabel.textContent = current.replace(/-/g, ' ');

      options.forEach((opt) => {
        const tid = opt.getAttribute('data-theme-id');
        const check = opt.querySelector('.theme-check-icon');
        if (tid === current) {
          opt.classList.add('bg-bg-secondary', 'border-accent');
          if (check) check.classList.remove('opacity-0');
        } else {
          opt.classList.remove('bg-bg-secondary', 'border-accent');
          if (check) check.classList.add('opacity-0');
        }
      });
    }

    function setTheme(id: string, mode: string) {
      document.documentElement.setAttribute('data-theme', id);
      document.documentElement.setAttribute('data-mode', mode);
      localStorage.setItem('omarchy-theme', id);
      localStorage.setItem('omarchy-mode', mode);
      updateActiveUI();
    }

    // Toggle dropdown
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = !menu.classList.contains('hidden');
      if (isOpen) {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        menu.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
        updateActiveUI();
      }
    });

    closeBtn?.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    });

    // Option selection
    options.forEach((opt) => {
      opt.addEventListener('click', () => {
        const id = opt.getAttribute('data-theme-id');
        const mode = opt.getAttribute('data-theme-mode') || 'dark';
        if (id) {
          setTheme(id, mode);
          menu.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
        }
      });
    });

    // Mode filter tabs
    filterBtns.forEach((fbtn) => {
      fbtn.addEventListener('click', () => {
        const filter = fbtn.getAttribute('data-filter');
        filterBtns.forEach((b) => {
          b.classList.remove('bg-bg-tertiary', 'text-accent');
          b.classList.add('text-fg-muted');
        });
        fbtn.classList.add('bg-bg-tertiary', 'text-accent');
        fbtn.classList.remove('text-fg-muted');

        options.forEach((opt) => {
          const optMode = opt.getAttribute('data-theme-mode');
          if (filter === 'all' || optMode === filter) {
            (opt as HTMLElement).style.display = 'flex';
          } else {
            (opt as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target as Node) && !btn.contains(e.target as Node)) {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      }
    });

    // Keyboard shortcut: Press 'T' to open
    document.addEventListener('keydown', (e) => {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
      if (e.key === 't' || e.key === 'T') {
        e.preventDefault();
        btn.click();
      } else if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      }
    });

    updateActiveUI();
  }

  // Initialize on load and page transitions
  initThemeSelector();
  document.addEventListener('astro:page-load', initThemeSelector);
</script>
