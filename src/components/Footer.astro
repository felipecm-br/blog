---
import { siteConfig } from '../data/siteConfig';
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-theme-border bg-bg-secondary text-fg-muted font-mono text-xs transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <!-- Left: Brand & Status -->
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-theme-green animate-pulse"></span>
        <span>felipecm // all systems nominal</span>
      </div>

      <!-- Center: Socials & RSS -->
      <div class="flex items-center gap-4">
        <a href={siteConfig.socials.github} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">
          GitHub
        </a>
        {siteConfig.socials.twitter && (
          <a href={siteConfig.socials.twitter} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">
            Twitter
          </a>
        )}
        <a href={`mailto:${siteConfig.socials.email}`} class="hover:text-accent transition-colors">
          Email
        </a>
        <a href="/rss.xml" class="hover:text-accent transition-colors flex items-center gap-1">
          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
          </svg>
          RSS
        </a>
      </div>

      <!-- Right: Copyright -->
      <div class="text-[11px] text-fg-muted">
        © {currentYear} {siteConfig.author} · Built with Astro & Omarchy
      </div>
    </div>
  </div>
</footer>
