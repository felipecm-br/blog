---
import { siteConfig } from '../data/siteConfig';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  schema?: Record<string, any>;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = siteConfig.seo.defaultImage,
  article = false,
  pubDate,
  updatedDate,
  schema,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
const fullTitle = title === siteConfig.title ? title : `${title} // ${siteConfig.author}`;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="author" content={siteConfig.author} />
<meta name="robots" content="index, follow" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:site_name" content={siteConfig.seo.siteName} />
<meta property="og:locale" content={siteConfig.locale} />

{article && pubDate && (
  <meta property="article:published_time" content={pubDate.toISOString()} />
)}
{article && updatedDate && (
  <meta property="article:modified_time" content={updatedDate.toISOString()} />
)}

<!-- Twitter Cards -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImageURL} />
<meta property="twitter:creator" content={siteConfig.seo.twitterHandle} />

<!-- Structured Data (JSON-LD) -->
{schema && (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
)}

<!-- Preload Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />

<!-- Zero-FOUC Theme & Mode Initializer -->
<script is:inline>
  (function () {
    try {
      const storedTheme = localStorage.getItem('omarchy-theme') || 'catppuccin';
      const storedMode = localStorage.getItem('omarchy-mode') || 'dark';
      document.documentElement.setAttribute('data-theme', storedTheme);
      document.documentElement.setAttribute('data-mode', storedMode);
    } catch (e) {
      document.documentElement.setAttribute('data-theme', 'catppuccin');
      document.documentElement.setAttribute('data-mode', 'dark');
    }
  })();
</script>
