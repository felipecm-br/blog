---
// Top reading progress indicator
---

<div id="reading-progress-container" class="fixed top-0 left-0 right-0 h-1 z-50 pointer-events-none bg-transparent">
  <div id="reading-progress-bar" class="h-full bg-accent transition-all duration-75 w-0"></div>
</div>

<script>
  function initProgress() {
    const bar = document.getElementById('reading-progress-bar');
    if (!bar) return;

    function update() {
      const scroll = window.scrollY;
      const height = document.documentElement.scrollHeight - window.innerHeight;
      if (height > 0) {
        const pct = Math.min(100, Math.max(0, (scroll / height) * 100));
        bar.style.width = `${pct}%`;
      }
    }

    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  initProgress();
  document.addEventListener('astro:page-load', initProgress);
</script>
