---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import CodeCopy from '../components/CodeCopy.astro';
import { generateArticleSchema, generateBreadcrumbSchema } from '../utils/seo';
import { getReadingTime } from '../utils/readingTime';
import { siteConfig } from '../data/siteConfig';

export interface Props {
  post: CollectionEntry<'blog'>;
  headings: Array<{ depth: number; slug: string; text: string }>;
}

const { post, headings } = Astro.props;
const readingTime = getReadingTime(post.body || '');
const currentUrl = new URL(Astro.url.pathname, Astro.site).toString();

const articleSchema = generateArticleSchema({
  title: post.data.title,
  description: post.data.description,
  pubDate: post.data.pubDate,
  updatedDate: post.data.updatedDate,
  url: currentUrl,
  image: post.data.heroImage,
  authorName: siteConfig.author,
});

const breadcrumbsSchema = generateBreadcrumbSchema([
  { name: 'Home', url: siteConfig.siteUrl },
  { name: 'Blog', url: new URL('/blog', siteConfig.siteUrl).toString() },
  { name: post.data.title, url: currentUrl },
]);

const combinedSchema = {
  "@context": "https://schema.org",
  "@graph": [articleSchema, breadcrumbsSchema],
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.heroImage}
  article={true}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  schema={combinedSchema}
>
  <ReadingProgress />
  <CodeCopy />

  <!-- Breadcrumbs & Back link -->
  <div class="mb-8 flex items-center justify-between">
    <a
      href="/blog"
      class="inline-flex items-center gap-1.5 text-xs font-mono text-fg-muted hover:text-accent transition-colors"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      <span>cd ~/blog</span>
    </a>

    <div class="flex items-center gap-2 text-xs font-mono text-fg-muted">
      <FormattedDate date={post.data.pubDate} />
      <span>·</span>
      <span>{readingTime}</span>
    </div>
  </div>

  <article class="relative">
    <!-- Header -->
    <header class="mb-10 pb-8 border-b border-theme-border">
      <div class="flex flex-wrap gap-2 mb-4">
        {post.data.tags.map((tag) => (
          <a
            href={`/tags/${tag}`}
            class="text-xs font-mono px-2.5 py-0.5 rounded bg-bg-secondary text-accent border border-theme-border hover:border-accent transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-fg-primary mb-4 leading-tight">
        {post.data.title}
      </h1>

      <p class="text-base sm:text-lg text-fg-secondary leading-relaxed">
        {post.data.description}
      </p>
    </header>

    <!-- Layout Grid: Content + TOC Sidebar -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-10">
      <!-- Main Article Prose -->
      <div class="lg:col-span-3 min-w-0">
        <div class="prose prose-neutral max-w-none text-fg-primary leading-relaxed">
          <slot />
        </div>

        <!-- Post Footer / Author Card -->
        <footer class="mt-14 pt-8 border-t border-theme-border">
          <div class="flex items-center gap-4 p-5 rounded-xl bg-bg-secondary border border-theme-border">
            <div class="w-12 h-12 rounded-full bg-accent/20 border border-accent/40 flex items-center justify-center font-mono text-accent font-bold text-lg shrink-0">
              FM
            </div>
            <div>
              <h4 class="text-sm font-bold text-fg-primary">{siteConfig.author}</h4>
              <p class="text-xs text-fg-secondary mt-0.5">
                Software engineer focused on terminal ergonomics, low-latency architectures, and Astro.
              </p>
            </div>
          </div>
        </footer>
      </div>

      <!-- Sticky Sidebar TOC -->
      <aside class="hidden lg:block lg:col-span-1">
        <div class="sticky top-24">
          <TableOfContents headings={headings} />
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
